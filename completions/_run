#compdef run

# Zsh completion for Shell Menu Runner
# Installation: copy to ~/.zsh/completions/_run or /usr/share/zsh/site-functions/_run

# Mirrors find_local_config() in src/06-profiles.sh: the script looks for a
# .tasks file in the current directory and in every parent directory and falls
# back to ~/.tasks.  The completion has to search the same places — otherwise
# no task is offered in a subdirectory of a project, although the script finds
# the config there.
_run_default_config() {
    local d="$PWD"
    while [ "$d" != "/" ]; do
        if [ -f "$d/.tasks" ]; then
            echo "$d/.tasks"
            return 0
        fi
        d="${d:h}"
    done
    if [ -f "$HOME/.tasks" ]; then
        echo "$HOME/.tasks"
        return 0
    fi
    return 1
}

# Offers the tasks of a config file.
#
# The entries are "name:description" — _describe uses the first unescaped
# colon as the separator, so a colon in the task name has to be escaped.
# The field splitting mirrors split_task_line() in the script: the last field
# keeps any remaining separators and a line without a description is still
# offered.
_run_describe_tasks() {
    local file="$1"
    [ -f "$file" ] || return 0

    local -a tasks
    local line rest name desc
    # The `|| [ -n "$line" ]` keeps a last line without trailing newline —
    # same guard as the script uses when it reads the config.
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            "0|"*) ;;
            *) continue ;;
        esac

        rest="$line"
        # level (not needed)
        if [ "${rest#*|}" != "$rest" ]; then rest="${rest#*|}"; else rest=""; fi
        # name
        if [ "${rest#*|}" != "$rest" ]; then
            name="${rest%%|*}"
            rest="${rest#*|}"
        else
            name="$rest"
            rest=""
        fi
        # command (not needed)
        if [ "${rest#*|}" != "$rest" ]; then rest="${rest#*|}"; else rest=""; fi
        # description — the remainder of the line
        desc="$rest"

        [ -n "$name" ] || continue
        tasks+=("${name//:/\\:}:$desc")
    done < "$file"

    if [ ${#tasks[@]} -gt 0 ]; then
        _describe 'tasks' tasks
    fi
}

_run_tasks() {
    local config_path
    config_path="$(_run_default_config)"
    [ -n "$config_path" ] && _run_describe_tasks "$config_path"
    return 0
}

_run_tasks_from_file() {
    local file="$1"
    [ -z "$file" ] && return 0
    [ ! -f "$file" ] && return 0
    _run_describe_tasks "$file"
    return 0
}

_run_resolve_profile() {
    local profile="$1"
    local resolved="$profile"
    if [ -f "$HOME/.run_aliases" ]; then
        local line alias_name target
        while IFS= read -r line || [ -n "$line" ]; do
            [ -z "$line" ] && continue
            case "$line" in
                \#*) continue ;;
            esac
            alias_name="${line%%=*}"
            target="${line#*=}"
            if [ "$alias_name" = "$profile" ]; then
                resolved="$target"
                break
            fi
        done < "$HOME/.run_aliases"
    fi
    echo "$resolved"
}

_run_find_profile_file() {
    local profile="$1"
    local d="$PWD"
    while [[ "$d" != "/" ]]; do
        if [ -f "$d/.tasks.$profile" ]; then
            echo "$d/.tasks.$profile"
            return 0
        fi
        d="${d:h}"
    done
    if [ -f "$HOME/.tasks.$profile" ]; then
        echo "$HOME/.tasks.$profile"
        return 0
    fi
    return 1
}

_run_profiles() {
    local -a profiles
    local -A seen
    local add_profile
    add_profile() {
        local name="$1"
        local desc="$2"
        if [ -n "$name" ] && [ -z "${seen[$name]}" ]; then
            if [ -n "$desc" ]; then
                profiles+=("${name}:${desc}")
            else
                profiles+=("${name}")
            fi
            seen[$name]=1
        fi
    }
    local d="$PWD"
    # `local f` once, outside the loop: a repeated `local f` inside a loop
    # makes zsh print "f=''" to stdout (typeset on an existing variable
    # prints its value) and pollutes the completion display.
    local f
    while [[ "$d" != "/" ]]; do
        for f in "$d"/.tasks.*(N); do
            add_profile "${${f:t}#.tasks.}" ""
        done
        d="${d:h}"
    done
    for f in "$HOME"/.tasks.*(N); do
        add_profile "${${f:t}#.tasks.}" ""
    done

    if [ -f "$HOME/.run_aliases" ]; then
        local line alias_name target
        while IFS= read -r line || [ -n "$line" ]; do
            [ -z "$line" ] && continue
            case "$line" in
                \#*) continue ;;
            esac
            alias_name="${line%%=*}"
            target="${line#*=}"
            add_profile "$alias_name" "alias to $target"
        done < "$HOME/.run_aliases"
    fi
    if [ ${#profiles[@]} -gt 0 ]; then
        _describe 'profiles' profiles
    fi
}

_run() {
    case "$words[2]" in
        --global|--edit|-e)
            # No task completion after these flags
            return 0
            ;;
        *)
            # The word right after "--run" is a task name — the flags are not
            # valid there (`run --run --edit` would look for a task named
            # "--edit"), so only the task names are offered.
            local i _run_at=0
            for (( i = 2; i < CURRENT; i++ )); do
                if [ "${words[i]}" = "--run" ]; then
                    _run_at=$i
                    break
                fi
            done
            if [ "$_run_at" -gt 0 ] && [ "$CURRENT" -eq $((_run_at + 1)) ]; then
                local resolved_profile profile_file
                resolved_profile="$(_run_resolve_profile "${words[2]}")"
                profile_file="$(_run_find_profile_file "$resolved_profile")"
                if [ -n "$profile_file" ]; then
                    _run_tasks_from_file "$profile_file"
                else
                    _run_tasks
                fi
                return 0
            fi

            # Show available commands and tasks
            _arguments \
                '(--help -h)'{--help,-h}'[Show help message]' \
                '(--version -v)'{--version,-v}'[Show version]' \
                '--init[Initialize new .tasks file]' \
                '--update[Self-update to latest version]' \
                '--global[Use global task file]' \
                '(--edit -e)'{--edit,-e}'[Edit task configuration]'

            if (( CURRENT == 2 )); then
                _run_profiles
            else
                local profile_input="${words[2]}"
                local resolved_profile
                resolved_profile="$(_run_resolve_profile "$profile_input")"
                local profile_file
                profile_file="$(_run_find_profile_file "$resolved_profile")"
                if [ -n "$profile_file" ]; then
                    _run_tasks_from_file "$profile_file"
                else
                    _run_tasks
                fi
            fi
            ;;
    esac
}

_run
